# ==============================================================================
# MediMind AI — Production & SaaS Environment Variables Example
# ==============================================================================
# Note: Do not commit actual secrets. Store real credentials in your Vercel
# / Cloud Environment Settings.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=production
PORT=3000

# Google Gemini API (Server-side privileged AI processing)
GEMINI_API_KEY=

# SaaS Payment Gateway: Razorpay (India-first Launch)
# Keep PAYMENT_ENVIRONMENT=sandbox until live merchant account is verified
PAYMENT_ENVIRONMENT=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SaaS Payment Gateway: Stripe (International USD Launch)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MediMind Business Console & Admin Protection
# Primary Authorized Owner: rautp0476@gmail.com
ADMIN_SECRET_KEY=

# Firebase Client Configuration (Cloud Firestore & Authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
