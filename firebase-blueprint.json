{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "location": { "type": "string", "description": "User location for local cost estimates" },
        "accessibilitySettings": {
          "type": "object",
          "description": "User's preferred accessibility settings",
          "properties": {
            "mode": { "type": "string", "enum": ["STANDARD", "HIGH_CONTRAST"] },
            "fontSize": { "type": "string", "enum": ["SMALL", "MEDIUM", "LARGE"] },
            "dyslexicFont": { "type": "boolean" }
          },
          "required": ["mode", "fontSize", "dyslexicFont"]
        }
      },
      "required": ["uid", "email"]
    },
    "Medication": {
      "title": "Medication",
      "description": "Medication tracking details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "dosage": { "type": "string", "maxLength": 50 },
        "frequency": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "instructions": { "type": "string", "maxLength": 500 },
        "lastTakenDate": { "type": "string", "format": "date" },
        "lastTakenTime": { "type": "string", "maxLength": 30 },
        "lastNotificationDate": { "type": "string", "format": "date" },
        "pillAppearance": { "type": "string", "maxLength": 300 },
        "pillColor": { "type": "string", "maxLength": 50 },
        "pillShape": { "type": "string", "maxLength": 50 },
        "pillImprint": { "type": "string", "maxLength": 50 },
        "pillPhoto": { "type": "string" }
      },
      "required": ["id", "name", "dosage", "frequency", "time", "instructions"]
    },
    "MoodEntry": {
      "title": "MoodEntry",
      "description": "Daily mood entry log",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "mood": { "type": "string", "enum": ["great", "good", "okay", "sad", "terrible"] }
      },
      "required": ["date", "mood"]
    },
    "StoredReport": {
      "title": "StoredReport",
      "description": "Stored analysis report result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "number" },
        "fileName": { "type": "string", "maxLength": 200 },
        "result": {
          "type": "object",
          "description": "Medical analysis result detail"
        }
      },
      "required": ["id", "date", "fileName", "result"]
    },
    "Vaccine": {
      "title": "Vaccine",
      "description": "Vaccination details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "dateGiven": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["VALID", "EXPIRED", "UPCOMING"] },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "dateGiven", "status", "notes"]
    },
    "HealthHistory": {
      "title": "HealthHistory",
      "description": "User medical history",
      "type": "object",
      "properties": {
        "conditions": { "type": "array", "items": { "type": "string" } },
        "surgeries": { "type": "array", "items": { "type": "string" } },
        "familyHistory": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "bloodType": { "type": "string", "maxLength": 5 },
        "organDonor": { "type": "boolean" },
        "emergencyContacts": { "type": "array", "description": "Emergency contacts for fast doctor/family calling" },
        "metrics": { "type": "array", "description": "Tracked health metrics over time" }
      },
      "required": ["conditions", "surgeries", "familyHistory", "allergies", "bloodType", "organDonor"]
    },
    "SymptomEntry": {
      "title": "SymptomEntry",
      "description": "Daily symptom log entry with severity and duration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "symptom": { "type": "string", "maxLength": 200 },
        "severity": { "type": "integer" },
        "duration": { "type": "string", "maxLength": 100 },
        "bodyPart": { "type": "string", "maxLength": 100 },
        "triggers": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "date", "symptom", "severity", "duration"]
    },
    "CareProfile": {
      "title": "CareProfile",
      "description": "Personalized friend or family member care profile (Hacktoberfest 'Build for a Friend')",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "relationship": { "type": "string", "maxLength": 100 },
        "ageRange": { "type": "string", "maxLength": 50 },
        "healthGoals": { "type": "string", "maxLength": 1000 },
        "knownConditions": { "type": "string", "maxLength": 1000 },
        "allergies": { "type": "string", "maxLength": 500 },
        "currentMedications": { "type": "string", "maxLength": 1000 },
        "preferredLanguage": { "type": "string", "maxLength": 50 },
        "careNotes": { "type": "string", "maxLength": 1500 },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "relationship"]
    },
    "MedicationIntakeLog": {
      "title": "MedicationIntakeLog",
      "description": "Historical medication intake compliance log and dosage records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "medicationId": { "type": "string", "maxLength": 128 },
        "medicationName": { "type": "string", "maxLength": 100 },
        "dosage": { "type": "string", "maxLength": 50 },
        "takenDate": { "type": "string", "format": "date" },
        "takenTime": { "type": "string", "maxLength": 30 },
        "scheduledTime": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["taken", "missed", "skipped"] },
        "timestamp": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "medicationId", "medicationName", "dosage", "takenDate", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Store user profile settings"
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": "Medication",
      "description": "Store user tracked medications"
    },
    "/users/{userId}/medicationLogs/{logId}": {
      "schema": "MedicationIntakeLog",
      "description": "Store user medication intake logs and compliance history"
    },
    "/users/{userId}/moods/{moodId}": {
      "schema": "MoodEntry",
      "description": "Store user mood log"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": "StoredReport",
      "description": "Store user uploaded analysis reports"
    },
    "/users/{userId}/vaccines/{vaccineId}": {
      "schema": "Vaccine",
      "description": "Store user vaccination records"
    },
    "/users/{userId}/symptoms/{symptomId}": {
      "schema": "SymptomEntry",
      "description": "Store user daily symptom journal entries"
    },
    "/users/{userId}/healthHistory/main": {
      "schema": "HealthHistory",
      "description": "Store user health profile history"
    },
    "/users/{userId}/careProfile/main": {
      "schema": "CareProfile",
      "description": "Store personalized care profile for friend or family member"
    }
  }
}
