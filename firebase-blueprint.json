{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "location": { "type": "string", "description": "User location for local cost estimates" },
        "accessibilitySettings": {
          "type": "object",
          "description": "User's preferred accessibility settings",
          "properties": {
            "mode": { "type": "string", "enum": ["STANDARD", "HIGH_CONTRAST"] },
            "fontSize": { "type": "string", "enum": ["SMALL", "MEDIUM", "LARGE"] },
            "dyslexicFont": { "type": "boolean" }
          },
          "required": ["mode", "fontSize", "dyslexicFont"]
        }
      },
      "required": ["uid", "email"]
    },
    "Medication": {
      "title": "Medication",
      "description": "Medication tracking details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "dosage": { "type": "string", "maxLength": 50 },
        "frequency": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "instructions": { "type": "string", "maxLength": 500 },
        "lastTakenDate": { "type": "string", "format": "date" },
        "lastNotificationDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "name", "dosage", "frequency", "time", "instructions"]
    },
    "MoodEntry": {
      "title": "MoodEntry",
      "description": "Daily mood entry log",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "mood": { "type": "string", "enum": ["great", "good", "okay", "sad", "terrible"] }
      },
      "required": ["date", "mood"]
    },
    "StoredReport": {
      "title": "StoredReport",
      "description": "Stored analysis report result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "number" },
        "fileName": { "type": "string", "maxLength": 200 },
        "result": {
          "type": "object",
          "description": "Medical analysis result detail"
        }
      },
      "required": ["id", "date", "fileName", "result"]
    },
    "Vaccine": {
      "title": "Vaccine",
      "description": "Vaccination details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "dateGiven": { "type": "string", "format": "date" },
        "nextDueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["VALID", "EXPIRED", "UPCOMING"] },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "name", "dateGiven", "status", "notes"]
    },
    "HealthHistory": {
      "title": "HealthHistory",
      "description": "User medical history",
      "type": "object",
      "properties": {
        "conditions": { "type": "array", "items": { "type": "string" } },
        "surgeries": { "type": "array", "items": { "type": "string" } },
        "familyHistory": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "bloodType": { "type": "string", "maxLength": 5 },
        "organDonor": { "type": "boolean" },
        "emergencyContacts": { "type": "array", "description": "Emergency contacts for fast doctor/family calling" },
        "metrics": { "type": "array", "description": "Tracked health metrics over time" }
      },
      "required": ["conditions", "surgeries", "familyHistory", "allergies", "bloodType", "organDonor"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Store user profile settings"
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": "Medication",
      "description": "Store user tracked medications"
    },
    "/users/{userId}/moods/{moodId}": {
      "schema": "MoodEntry",
      "description": "Store user mood log"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": "StoredReport",
      "description": "Store user uploaded analysis reports"
    },
    "/users/{userId}/vaccines/{vaccineId}": {
      "schema": "Vaccine",
      "description": "Store user vaccination records"
    },
    "/users/{userId}/healthHistory/main": {
      "schema": "HealthHistory",
      "description": "Store user health profile history"
    }
  }
}
